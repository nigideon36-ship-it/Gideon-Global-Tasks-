{
  "entities": {
    "User": {
      "title": "User",
      "description": "User contributor profile and earnings account",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["customer", "owner"] },
        "balance": { "type": "number" },
        "streakDays": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "balance", "streakDays", "createdAt", "updatedAt"]
    },
    "CompletedTask": {
      "title": "CompletedTask",
      "description": "Log of completed micro tasks, surveys, and annotations",
      "type": "object",
      "properties": {
        "userUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "taskId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "taskTitle": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 64 },
        "reward": { "type": "number" },
        "status": { "type": "string", "enum": ["Approved", "Pending", "Rejected"] },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userUid", "taskId", "taskTitle", "category", "reward", "status", "completedAt"]
    },
    "Withdrawal": {
      "title": "Withdrawal",
      "description": "Customer payout withdrawal request",
      "type": "object",
      "properties": {
        "userUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "amount": { "type": "number" },
        "method": { "type": "string", "enum": ["M-PESA", "PayPal", "Wise", "Crypto USDT", "Bank Wire", "Amazon Gift Card"] },
        "details": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["Pending", "Completed", "Rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userUid", "amount", "method", "details", "status", "createdAt", "updatedAt"]
    },
    "MarketplaceTask": {
      "title": "MarketplaceTask",
      "description": "Owner-managed task listing in marketplace",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 2000 },
        "reward": { "type": "number" },
        "totalSpots": { "type": "number" },
        "spotsRemaining": { "type": "number" },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "description", "reward", "totalSpots", "spotsRemaining", "ownerUid", "createdAt", "updatedAt"]
    },
    "PlatformSetting": {
      "title": "PlatformSetting",
      "description": "Owner-only website, AdSense, and payment gateway configuration",
      "type": "object",
      "properties": {
        "adsensePublisherId": { "type": "string", "maxLength": 64 },
        "adsenseClientId": { "type": "string", "maxLength": 64 },
        "paypalEmail": { "type": "string", "maxLength": 200 },
        "themeColor": { "type": "string", "maxLength": 32 },
        "updatedBy": { "type": "string", "maxLength": 200 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["updatedBy", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Customer and owner profiles"
    },
    "/completed_tasks/{taskId}": {
      "schema": "CompletedTask",
      "description": "Customer completed tasks log"
    },
    "/withdrawals/{withdrawalId}": {
      "schema": "Withdrawal",
      "description": "Customer withdrawal requests"
    },
    "/tasks/{taskId}": {
      "schema": "MarketplaceTask",
      "description": "Owner-managed marketplace tasks"
    },
    "/platform_settings/{settingId}": {
      "schema": "PlatformSetting",
      "description": "Owner-managed site and AdSense settings"
    }
  }
}
